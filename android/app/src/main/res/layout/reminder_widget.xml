<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#171E30"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🪐 ORBIT REMINDERS"
        android:textColor="#A8B4C8"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_line1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#F3F6FC"
        android:textSize="14sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_detail1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#8492AA"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_line2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#F3F6FC"
        android:textSize="14sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_detail2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#8492AA"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_line3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#F3F6FC"
        android:textSize="14sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_detail3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#8492AA"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Everyone is in a good rhythm ✨"
        android:textColor="#16B981"
        android:textSize="12sp" />
</LinearLayout>
